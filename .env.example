# Copia este archivo como .env (el .env NO se sube a GitHub).
# Todas las claves son opcionales: sin ninguna, la web usa el modo copiar/pegar con Claude Pro.

# Recomendado (gratis): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Alternativa de pago: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

MAX_INPUT_CHARS=8000
FLASK_DEBUG=1
